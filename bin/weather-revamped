#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh
set -eu

weather_revamped_self="$0"
case "${weather_revamped_self}" in
*/*) ;;
*) weather_revamped_self="$(command -v -- "${weather_revamped_self}")" ;;
esac
weather_revamped_lib="$(cd "${weather_revamped_self%/*}/../lib" && pwd)" || exit 1

for weather_revamped_inherited in $(env | sed -n -e 's/^\(REVAMPED_[A-Za-z0-9_]*\)=.*/\1/p' -e 's/^\(WEATHER_REVAMPED_[A-Za-z0-9_]*_LOADED\)=.*/\1/p'); do
  case "${weather_revamped_inherited}" in
  REVAMPED_TEST_*) continue ;;
  *) unset "${weather_revamped_inherited}" ;;
  esac
done

REVAMPED_LIB="${weather_revamped_lib}"
# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${REVAMPED_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/weather.sh
. "${REVAMPED_LIB}/weather.sh"

weather_revamped_interface() {
  # shellcheck disable=SC2034
  REVAMPED_UI_NAME=weather-revamped REVAMPED_UI_VERSION="${WEATHER_REVAMPED_VERSION}" REVAMPED_UI_TAGLINE="weather from wttr.in in the status bar"
  if [ -n "${WEATHER_REVAMPED_ACCENT:-}" ]; then
    # shellcheck disable=SC2034
    REVAMPED_UI_ACCENT_CHOICE="${WEATHER_REVAMPED_ACCENT}" REVAMPED_UI_ACCENT_NAME=WEATHER_REVAMPED_ACCENT
  fi
  # shellcheck source=SCRIPTDIR/../lib/cli.sh
  . "${REVAMPED_LIB}/cli.sh"
  # shellcheck source=SCRIPTDIR/../lib/doctor.sh
  . "${REVAMPED_LIB}/doctor.sh"
}

weather_revamped_usage() {
  weather_revamped_interface
  revamped_cli_usage_error "$1"
}

weather_revamped_bad() {
  weather_revamped_interface
  revamped_cli_die "$1"
}

weather_revamped_help() {
  revamped_cli_help_page <<'HELP'
weather-revamped - weather from wttr.in in the status bar

usage:
  weather-revamped apply                  bind the keys and fill the
                                          placeholders
  weather-revamped list                   print what apply would send to tmux
  weather-revamped status NAME [PLACE]    print one placeholder, for the
                                          first location or for PLACE
  weather-revamped refresh [PLACE]        fetch the weather now
  weather-revamped card [PLACE]           print the whole reading as a table
  weather-revamped popup [PLACE]          open the card in a tmux popup
  weather-revamped daemon                 publish the placeholders on every
                                          tick, for the options render mode
  weather-revamped doctor                 check this machine
  weather-revamped version                print the version
  weather-revamped help                   print this page

keys:
  --popup-key KEY            the prefix key for the forecast popup, or off
  --refresh-key KEY          a prefix key that fetches now; none by default

reading:
  --location PLACE           a city or place; empty lets wttr.in locate you
                             by IP
  --locations LIST           places separated by semicolons; the first one
                             fills the placeholders
  --units m|u                m for Celsius and km/h, u for Fahrenheit and mph;
                             f, fahrenheit and imperial are read as u
  --fetch-minutes MINUTES    how long a reading stays fresh, 1 or more
  --alerts on|off            on fetches the alert address after each reading
  --alert-url URL            the alert address; {loc} becomes the place
  --notify 0|1               1 sends a desktop notification for a new alert
  --render MODE              jobs or options
  --interval SECONDS         seconds between ticks in the options mode

formats:
  --hide-units on|off        on drops the C or F from #{weather_temp}
  --fixed-width on|off       on pads the temperature to five characters
  --temp-width COUNT         the width of the temperature
  --show-condition-icon on|off
                             off empties #{weather_condition_icon}
  --SKY-condition-icon TEXT  the icon of one sky: clear, clouds, rain, snow,
                             storm or fog
  --SKY-tint STYLE           what #{weather_condition_tint} prints for a sky
  --BAND-color STYLE         what #{weather_color} prints in one band:
                             freezing, cold, cool, comfortable, hot or
                             very-hot
  --BAND-icon TEXT           what #{weather_icon} prints in one band
  --uv-LEVEL-color STYLE     what #{weather_uv_color} prints at one level:
                             low, moderate, high, very-high or extreme
  --stale-color STYLE        what #{weather_stale_color} prints once the
                             last answer is older than three intervals
  --umbrella-text TEXT       what #{weather_umbrella} prints; {chance}
                             becomes the rain chance
  --umbrella-threshold PERCENT
                             the rain chance that shows the umbrella text
  --pressure-delta HPA       the change that counts as rising or falling
  --pressure-rising TEXT     the mark of a rising pressure
  --pressure-falling TEXT    the mark of a falling pressure
  --pressure-steady TEXT     the mark of a steady pressure
  --alert-prefix TEXT        text before #{weather_alert}

output:
  --json                     list prints one JSON object
  --theme NAME               the look: kodougu, catppuccin-mocha,
                             catppuccin-latte, dracula, nord, gruvbox,
                             tokyo-night or mono

environment:
  WEATHER_REVAMPED_<SETTING>   the same as the option of that name, such as
                               WEATHER_REVAMPED_UNITS for --units
  WEATHER_REVAMPED_THEME       the look, when --theme is not given
  WEATHER_REVAMPED_ACCENT      a colour such as #CBA6F7 for the accent
  KODOUGU_THEME                the family look, when neither is given
  KODOUGU_ACCENT               the family accent, when the tool's is unset
  NO_COLOR                     turn colour off

tmux options:
  @weather_revamped_popup_key           the forecast popup key (default M-w)
  @weather_revamped_refresh_key         a key that fetches now (default none)
  @weather_revamped_location            city or place (default none, by IP)
  @weather_revamped_locations           places separated by semicolons
                                        (default none)
  @weather_revamped_units               m or u (default m)
  @weather_revamped_fetch_minutes       minutes a reading stays fresh
                                        (default 15)
  @weather_revamped_alerts              on or off (default off)
  @weather_revamped_alert_url           alert address (default none)
  @weather_revamped_alert_prefix        text before the alert (default none)
  @weather_revamped_notify              1 notifies of a new alert (default 0)
  @weather_revamped_render              jobs or options (default jobs)
  @weather_revamped_interval            seconds between ticks (default 60)
  @weather_revamped_hide_units          on or off (default off)
  @weather_revamped_fixed_width         on or off (default off)
  @weather_revamped_temp_width          width of the temperature
                                        (default none)
  @weather_revamped_show_condition_icon on or off (default on)
  @weather_revamped_<sky>_condition_icon
                                        icon of one sky (default a Nerd Font
                                        glyph)
  @weather_revamped_<sky>_tint          style of one sky (default yellow for
                                        clear, brightblack for clouds and
                                        fog, blue for rain, white for snow,
                                        magenta for storm)
  @weather_revamped_<band>_color        style of one band (default blue,
                                        cyan, green, green, yellow, red)
  @weather_revamped_<band>_icon         icon of one band (default none)
  @weather_revamped_uv_<level>_color    style of one UV level (default
                                        green, yellow, colour208, red,
                                        magenta)
  @weather_revamped_stale_color         style of a stale reading
                                        (default "#[dim]")
  @weather_revamped_umbrella_text       umbrella text (default none)
  @weather_revamped_umbrella_threshold  rain chance that shows it
                                        (default 50)
  @weather_revamped_pressure_delta      hPa that count as a change
                                        (default 1)
  @weather_revamped_pressure_rising     rising mark (default ^)
  @weather_revamped_pressure_falling    falling mark (default v)
  @weather_revamped_pressure_steady     steady mark (default =)
  @revamped_theme                       the family look (default kodougu)

notes:
  NAME is weather, temp, feels_like, wind, humidity, pressure,
  pressure_trend, precip, rain_chance, umbrella, uv, uv_color, dew_point,
  dew_comfort, moon, sunrise, sunset, forecast, today_high, today_low,
  tomorrow_high, tomorrow_low, condition_icon, condition_tint, color, icon,
  stale_color or alert. The placeholders are #{weather} and
  #{weather_<name>}. Each prints the stored reading at once, and starts one
  background fetch when the reading is older than the fetch interval. An
  answer that says the location is unknown is dropped and the last reading
  stays. With --render options each placeholder reads a tmux option that a
  background process fills on every tick, so a status refresh starts no
  process. An on or off setting also reads 1, yes and true as on, and 0, no
  and false as off. A tmux option that holds any other value takes its
  default, and doctor names it.

examples:
  weather-revamped status weather
  weather-revamped card Lisbon
  weather-revamped --units u --location "New York" apply
  weather-revamped list --json
HELP
}

weather_revamped_show_version() {
  weather_revamped_show_version_tmux=$(tmux -V 2>/dev/null) || weather_revamped_show_version_tmux=missing
  printf '%s %s\n' weather-revamped "${WEATHER_REVAMPED_VERSION}"
  printf 'tmux: %s\n' "${weather_revamped_show_version_tmux#tmux }"
}

weather_revamped_label() {
  WEATHER_REVAMPED_LABEL="${WEATHER_REVAMPED_PLACE}"
  [ -n "${WEATHER_REVAMPED_LABEL}" ] || WEATHER_REVAMPED_LABEL="the current location"
}

weather_revamped_since() {
  WEATHER_REVAMPED_SINCE=""
  revamped_cache_is_number "${WEATHER_REVAMPED_OK_TS}" || return 0
  weather_revamped_since_minutes=$(((WEATHER_REVAMPED_NOW - WEATHER_REVAMPED_OK_TS) / 60))
  case "${weather_revamped_since_minutes}" in
  1) WEATHER_REVAMPED_SINCE="1 minute ago" ;;
  *) WEATHER_REVAMPED_SINCE="${weather_revamped_since_minutes} minutes ago" ;;
  esac
}

weather_revamped_recollect() {
  weather_revamped_load
  weather_revamped_now
  weather_revamped_limit
  weather_revamped_choose "$1"
  weather_revamped_recall
  weather_revamped_label
}

weather_revamped_doctor_curl() {
  weather_revamped_doctor_curl_note=""
  if revamped_has_command curl; then
    weather_revamped_doctor_curl_raw=$(curl --version 2>/dev/null) || weather_revamped_doctor_curl_raw=""
    weather_revamped_doctor_curl_note=$(revamped_doctor_version "${weather_revamped_doctor_curl_raw}")
  fi
  revamped_doctor_required curl "it fetches the weather: brew install curl, or apt install curl" "${weather_revamped_doctor_curl_note}"
}

weather_revamped_doctor_reading() {
  weather_revamped_choose ""
  weather_revamped_recall
  weather_revamped_label
  weather_revamped_now
  weather_revamped_since
  if [ -n "${WEATHER_REVAMPED_VALUE}" ] && [ -n "${WEATHER_REVAMPED_SINCE}" ]; then
    revamped_doctor_line reading ok "${WEATHER_REVAMPED_LABEL}, answered ${WEATHER_REVAMPED_SINCE}"
    return 0
  fi
  revamped_doctor_line reading warn "none yet for ${WEATHER_REVAMPED_LABEL}: run weather-revamped refresh"
}

weather_revamped_doctor_settings() {
  if [ -n "${WEATHER_REVAMPED_ODD}" ]; then
    revamped_doctor_line settings warn "unknown values, so their defaults apply: ${WEATHER_REVAMPED_ODD}"
    return 0
  fi
  revamped_doctor_line settings ok "every option holds a value it knows"
}

weather_revamped_doctor_keys() {
  if [ -n "${WEATHER_REVAMPED_SKIPPED}" ]; then
    revamped_doctor_line keys warn "already bound and left alone: ${WEATHER_REVAMPED_SKIPPED}"
    return 0
  fi
  revamped_doctor_line keys ok "every key it binds is free or its own"
}

weather_revamped_doctor() {
  weather_revamped_plan
  revamped_doctor_tmux
  weather_revamped_doctor_curl
  weather_revamped_doctor_reading
  weather_revamped_doctor_settings
  revamped_doctor_notifier
  weather_revamped_doctor_keys
  revamped_doctor_gum
  revamped_doctor_core_tools awk sed tr date
  revamped_doctor_finish
  [ "${REVAMPED_DOCTOR_MISSING}" -eq 0 ] || exit 1
}

weather_revamped_list() {
  weather_revamped_plan
  if [ -n "${weather_revamped_json}" ]; then
    weather_revamped_json
    return 0
  fi
  weather_revamped_lines
}

weather_revamped_apply_command() {
  weather_revamped_apply
  weather_revamped_apply_command_sent=$(weather_revamped_bindings)
  case "${weather_revamped_apply_command_sent}" in
  1) printf 'Applied. 1 key is bound.\n' ;;
  *) printf 'Applied. %s keys are bound.\n' "${weather_revamped_apply_command_sent}" ;;
  esac
}

weather_revamped_refresh_command() {
  weather_revamped_recollect "$1"
  weather_revamped_fetch
  [ "${WEATHER_REVAMPED_STORED}" = 1 ] || weather_revamped_bad "no tmux server is running, so the reading has nowhere to go"
  [ -n "${WEATHER_REVAMPED_FETCHED}" ] || weather_revamped_bad "wttr.in gave no reading for ${WEATHER_REVAMPED_LABEL}, so the last one stays"
  weather_revamped_read
  weather_revamped_line
  printf 'Refreshed. wttr.in says %s for %s.\n' "${WEATHER_REVAMPED_LINE}" "${WEATHER_REVAMPED_LABEL}"
}

weather_revamped_card_row() {
  WEATHER_REVAMPED_CARD="${WEATHER_REVAMPED_CARD}$1	${2:--}
"
}

weather_revamped_card_rows() {
  weather_revamped_degree
  weather_revamped_card_unit="${WEATHER_REVAMPED_DEGREE}${WEATHER_REVAMPED_SUFFIX}"
  weather_revamped_line
  weather_revamped_value_wind
  weather_revamped_card_wind="${WEATHER_REVAMPED_OUT}"
  weather_revamped_value_dew_comfort
  WEATHER_REVAMPED_CARD=""
  weather_revamped_card_row Location "${WEATHER_REVAMPED_LABEL}"
  weather_revamped_card_row Now "${WEATHER_REVAMPED_LINE}${WEATHER_REVAMPED_R_feels:+, feels ${WEATHER_REVAMPED_R_feels}${weather_revamped_card_unit}}"
  weather_revamped_card_row Wind "${weather_revamped_card_wind}"
  weather_revamped_card_row Humidity "${WEATHER_REVAMPED_R_humidity:+${WEATHER_REVAMPED_R_humidity}%}"
  weather_revamped_card_row Pressure "${WEATHER_REVAMPED_R_pressure:+${WEATHER_REVAMPED_R_pressure} hPa}"
  weather_revamped_card_row UV "${WEATHER_REVAMPED_R_uv}"
  weather_revamped_card_row "Dew point" "${WEATHER_REVAMPED_R_dew:+${WEATHER_REVAMPED_R_dew}${weather_revamped_card_unit}, ${WEATHER_REVAMPED_OUT}}"
  weather_revamped_card_row Precipitation "${WEATHER_REVAMPED_R_precip:+${WEATHER_REVAMPED_R_precip} mm}"
  weather_revamped_card_row "Rain chance" "${WEATHER_REVAMPED_R_rain:+${WEATHER_REVAMPED_R_rain}%}"
  weather_revamped_card_row Sun "${WEATHER_REVAMPED_R_sunrise:+${WEATHER_REVAMPED_R_sunrise} to ${WEATHER_REVAMPED_R_sunset}}"
  weather_revamped_card_row Moon "${WEATHER_REVAMPED_R_moon}"
  weather_revamped_card_row Today "${WEATHER_REVAMPED_R_today_low:+${WEATHER_REVAMPED_R_today_low} to ${WEATHER_REVAMPED_R_today_high}${weather_revamped_card_unit}}"
  weather_revamped_card_row Tomorrow "${WEATHER_REVAMPED_R_tomorrow_low:+${WEATHER_REVAMPED_R_tomorrow_low} to ${WEATHER_REVAMPED_R_tomorrow_high}${weather_revamped_card_unit}}"
  [ "${WEATHER_REVAMPED_S_alerts}" != on ] || weather_revamped_card_row Alert "${WEATHER_REVAMPED_ALERT:-none}"
}

weather_revamped_card() {
  weather_revamped_recollect "$1"
  weather_revamped_fresh
  weather_revamped_read
  weather_revamped_card_rows
  weather_revamped_since
  weather_revamped_card_closing="Read. wttr.in has given no reading for ${WEATHER_REVAMPED_LABEL} yet."
  [ -z "${WEATHER_REVAMPED_VALUE}" ] || weather_revamped_card_closing="Read. wttr.in answered ${WEATHER_REVAMPED_SINCE:-at an unknown time}."
  if revamped_ui_out; then
    printf 'Reading\tValue\n%s' "${WEATHER_REVAMPED_CARD}" | revamped_ui_table
    revamped_ui_done "${weather_revamped_card_closing}"
    return 0
  fi
  printf '%s' "${WEATHER_REVAMPED_CARD}" | awk -F '\t' '{ printf "%-18s %s\n", $1, $2 }'
  printf '%s\n' "${weather_revamped_card_closing}"
}

weather_revamped_status_command() {
  case " ${WEATHER_REVAMPED_TOKENS} " in
  *" ${1:-} "*) weather_revamped_status "$1" "${2:-}" ;;
  *) weather_revamped_status_refused "${1:-}" ;;
  esac
}

weather_revamped_status_refused() {
  [ -n "$1" ] || weather_revamped_usage "no placeholder given"
  weather_revamped_bad "status must be a placeholder name such as weather, temp or wind, listed by weather-revamped help, got: $1"
}

weather_revamped_daemon_command() {
  set +e
  weather_revamped_daemon
  weather_revamped_daemon_command_ended=$?
  set -e
  [ "${weather_revamped_daemon_command_ended}" -ne 0 ] || exec "${weather_revamped_self}" daemon
}

weather_revamped_start_menu() {
  revamped_cli_require_terminal
  weather_revamped_start_menu_choice=$(revamped_cli_menu "Show the weather now" "List the bindings" "Apply them now" "Check this machine" "Help")
  case "${weather_revamped_start_menu_choice}" in
  "Show the weather now") weather_revamped_card "" ;;
  "List the bindings") weather_revamped_list ;;
  "Apply them now") weather_revamped_apply_command ;;
  "Check this machine") weather_revamped_doctor ;;
  *) weather_revamped_help ;;
  esac
}

weather_revamped_dispatch() {
  case "${1:-}" in
  doctor) weather_revamped_doctor ;;
  version | --version | -V) weather_revamped_show_version ;;
  help | --help | -h) weather_revamped_help ;;
  list) weather_revamped_list ;;
  card) weather_revamped_card "${2:-}" ;;
  refresh) weather_revamped_refresh_command "${2:-}" ;;
  "") weather_revamped_start_menu ;;
  *) revamped_cli_usage_error "unknown command '$1'" ;;
  esac
}

weather_revamped_known() {
  [ "$1" != --theme ] || return 0
  weather_revamped_known_name=$(weather_revamped_setting_name "$1")
  [ -n "${weather_revamped_known_name}" ] || weather_revamped_usage "unknown option '$1'"
}

weather_revamped_set() {
  weather_revamped_set_upper=$(printf '%s\n' "$1" | tr '[:lower:]' '[:upper:]')
  export "WEATHER_REVAMPED_${weather_revamped_set_upper}=$2"
}

weather_revamped_option() {
  weather_revamped_option_name=$(weather_revamped_setting_name "$1")
  [ -n "${weather_revamped_option_name}" ] || weather_revamped_usage "unknown option '$1'"
  weather_revamped_set "${weather_revamped_option_name}" "$2"
}

weather_revamped_check_switch() {
  case "$2" in
  on | off | 1 | 0 | yes | no | true | false) return 0 ;;
  *) weather_revamped_bad "--$1 must be on or off, got: $2" ;;
  esac
}

weather_revamped_check_numbers() {
  weather_revamped_check_numbers_bad=$(env | awk -F '=' '$1 ~ /^WEATHER_REVAMPED_(INTERVAL|FETCH_MINUTES|UMBRELLA_THRESHOLD|PRESSURE_DELTA|TEMP_WIDTH)$/ { value = substr($0, length($1) + 2); if (value != "" && value !~ /^[0-9]+$/) { name = tolower(substr($1, 18)); gsub(/_/, "-", name); if (bad == "") { bad = name "=" value } } } END { if (bad != "") { print bad } }')
  [ -z "${weather_revamped_check_numbers_bad}" ] || weather_revamped_bad "--${weather_revamped_check_numbers_bad%%=*} must be a whole number, got: ${weather_revamped_check_numbers_bad#*=}"
}

weather_revamped_check_choices() {
  case "${WEATHER_REVAMPED_UNITS-m}" in
  m | u | f | F | fahrenheit | Fahrenheit | imperial) : ;;
  *) weather_revamped_bad "--units must be m, u, f, fahrenheit or imperial, got: ${WEATHER_REVAMPED_UNITS}" ;;
  esac
  case "${WEATHER_REVAMPED_NOTIFY-0}" in
  0 | 1) : ;;
  *) weather_revamped_bad "--notify must be 0 or 1, got: ${WEATHER_REVAMPED_NOTIFY}" ;;
  esac
  case "${WEATHER_REVAMPED_RENDER-jobs}" in
  jobs | options) return 0 ;;
  *) weather_revamped_bad "--render must be jobs or options, got: ${WEATHER_REVAMPED_RENDER}" ;;
  esac
}

weather_revamped_check_fetch() {
  case "${WEATHER_REVAMPED_FETCH_MINUTES-15}" in
  '' | *[!0]*) return 0 ;;
  *) weather_revamped_bad "--fetch-minutes must be a whole number of at least 1, got: ${WEATHER_REVAMPED_FETCH_MINUTES}" ;;
  esac
}

weather_revamped_check() {
  weather_revamped_check_numbers
  weather_revamped_check_fetch
  weather_revamped_check_switch hide-units "${WEATHER_REVAMPED_HIDE_UNITS-off}"
  weather_revamped_check_switch alerts "${WEATHER_REVAMPED_ALERTS-off}"
  weather_revamped_check_switch show-condition-icon "${WEATHER_REVAMPED_SHOW_CONDITION_ICON-on}"
  weather_revamped_check_switch fixed-width "${WEATHER_REVAMPED_FIXED_WIDTH-off}"
  weather_revamped_check_choices
}

weather_revamped_main() {
  weather_revamped_theme="${WEATHER_REVAMPED_THEME:-}" weather_revamped_json="" weather_revamped_left=$# weather_revamped_rest=0
  while [ "${weather_revamped_left}" -gt 0 ]; do
    weather_revamped_arg="$1"
    shift
    weather_revamped_left=$((weather_revamped_left - 1))
    case "${weather_revamped_rest}:${weather_revamped_arg}" in
    1:*) set -- "$@" "${weather_revamped_arg}" ;;
    0:--) weather_revamped_rest=1 ;;
    0:--json) weather_revamped_json=1 ;;
    0:-h | 0:-V | 0:--help | 0:--version) set -- "$@" "${weather_revamped_arg}" ;;
    0:--theme=*) weather_revamped_theme="${weather_revamped_arg#--theme=}" ;;
    0:--*=*) weather_revamped_option "${weather_revamped_arg%%=*}" "${weather_revamped_arg#*=}" ;;
    0:--*)
      weather_revamped_known "${weather_revamped_arg}"
      [ "${weather_revamped_left}" -gt 0 ] || weather_revamped_usage "option '${weather_revamped_arg}' needs a value"
      if [ "${weather_revamped_arg}" = --theme ]; then
        weather_revamped_theme="$1"
      else
        weather_revamped_option "${weather_revamped_arg}" "$1"
      fi
      shift
      weather_revamped_left=$((weather_revamped_left - 1))
      ;;
    0:-?*) weather_revamped_usage "unknown option '${weather_revamped_arg}'" ;;
    *) set -- "$@" "${weather_revamped_arg}" ;;
    esac
  done
  weather_revamped_check
  weather_revamped_run "${weather_revamped_theme}" "$@"
}

weather_revamped_run() {
  weather_revamped_run_theme="$1"
  shift
  [ -z "${weather_revamped_json}" ] || [ "${1:-}" = list ] || weather_revamped_usage "option '--json' works only with list"
  case "${1:-}" in
  apply) weather_revamped_apply ;;
  status) weather_revamped_status_command "${2:-}" "${3:-}" ;;
  popup) weather_revamped_popup "${2:-}" ;;
  daemon) weather_revamped_daemon_command ;;
  *)
    weather_revamped_interface
    revamped_cli_start "${weather_revamped_run_theme}"
    weather_revamped_dispatch "$@"
    ;;
  esac
}

weather_revamped_main "$@"
